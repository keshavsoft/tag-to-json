{
  "name": "@keshavsoft/tag-to-json",
  "version": "1.4.2",
  "description": "Zero-dependency native DOM element to declarative JSON specification extractor. Perfect companion for json-to-tag.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "module": "./src/v2/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./v1": "./src/v1/index.js",
    "./v2": "./src/v2/index.js",
    "./v3": "./src/v3/index.js",
    "./v4": "./src/v4/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs/dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "node publish.js"
  },
  "keywords": [
    "dom-to-json",
    "tag-to-json",
    "json-to-tag",
    "html-parser",
    "dom-serializer",
    "declarative-dom"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "devDependencies": {
    "adm-zip": "^0.5.12",
    "vite": "^5.4.2"
  },
  "dependencies": {}
}